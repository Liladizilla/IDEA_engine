# Copy to .env and fill in. Never commit .env.
APP_ENV=development

DATABASE_URL=postgresql+asyncpg://idea:idea@localhost:5432/idea
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=

# YouTube Data API v3 (console.cloud.google.com -> enable "YouTube Data API v3")
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_BUDGET=8000

# Reddit (reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=idea-app/0.1 by u/your_username

# AI providers. AI_PROVIDER: huggingface | openai_compatible | local
AI_PROVIDER=huggingface
HF_TOKEN=
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_CHAT_MODEL=

# Cost control
AI_DAILY_TOKEN_LIMIT_GLOBAL=500000
AI_DAILY_TOKEN_LIMIT_PER_USER=40000
AI_MONTHLY_COST_LIMIT_USD=25

# Optional providers
ANSWERTHEPUBLIC_API_KEY=
GOOGLE_TRENDS_API_KEY=

# Ops
SENTRY_DSN=
FIREBASE_PROJECT_ID=
